# API Keys (only OpenAI is required; leave the others blank to turn those features off)
OPENAI_API_KEY=your_openai_api_key_here
PERPLEXITY_API_KEY=
VECTARA_API_KEY=
LANGSMITH_API_KEY=

# Configuration
CHROMA_DB_PATH=./data/chroma_db
LOG_LEVEL=INFO
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o

# RAG Parameters
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
RETRIEVAL_K=15
MIN_EVAL_SCORE=0.35

# Evaluation settings
ENABLE_FACTUAL_CONSISTENCY_SCORE=true
MIN_FCS_THRESHOLD=0.9
